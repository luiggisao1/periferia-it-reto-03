# Proveedor LLM ("openai" | "gemini" | "anthropic" | "auto")
# Si es "auto", selecciona automáticamente según qué API KEY esté definida.
LLM_PROVIDER=auto

# Claves de API (configura al menos una para usar LLM real en el chat)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Modelo opcional (si se deja vacío, usa el modelo por defecto del proveedor activo:
# OpenAI: gpt-4o-mini | Gemini: gemini-2.0-flash | Anthropic: claude-3-5-haiku-latest)
LLM_MODEL=

# Límites de control de costos y seguridad del ciclo del agente (Sección 6.3 y 8)
MAX_ITERATIONS=25
MAX_SESSION_TOKENS=100000
LLM_TIMEOUT_MS=45000

# Puerto del servidor HTTP y Web
PORT=3000
